# Kernel configuration for full DroidSpaces support on GKI kernels
# (android12-5.10, ingres/sm8450)
#
# Source: ravindu644/Droidspaces-OSS, Documentation/Kernel-Configuration.md,
# "Configuring GKI Kernels" section - the GKI-exclusive list, NOT the
# Non-GKI/legacy list (some legacy options like CONFIG_USER_NS are NOT
# kABI-safe on GKI and are deliberately left out here).
#
# These options only produce a bootable kernel when combined with the two
# kABI patches (below-kernel-6.12 001 + 002) - see the "Compile Kernel" step
# in build.yml, which applies them before this fragment gets merged in via
# DROIDSPACES_CONFIG.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Networking (Enhanced NAT support)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- Below configs are optional but recommended ---

# UFW support
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Enable xattr, posix acl support on tmpfs (NixOS support)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
